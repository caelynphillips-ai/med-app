# Azur Well environment template
# Placeholder values only. Do not put real secrets in this file.
# The current app still uses checked-in Firebase config files; this file is for partner setup planning.

APP_NAME=Azur Well
APP_SCHEME=your-app-scheme
ANDROID_PACKAGE=com.example.azurwell
IOS_BUNDLE_ID=com.example.azurwell

FIREBASE_API_KEY=your-firebase-web-api-key
