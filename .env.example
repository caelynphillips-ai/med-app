# Azur Well environment template
# Placeholder values only. Do not put real secrets in this file.
# Copy this file to .env.local for local web and Expo development.
# Checked-in Firebase values remain fallback configuration for environments without env values.

APP_NAME=Azur Well
APP_SCHEME=your-app-scheme
ANDROID_PACKAGE=com.example.azurwell
IOS_BUNDLE_ID=com.example.azurwell

EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-firebase-web-app-id

EXPO_OWNER=your-expo-owner
EXPO_PROJECT_ID=your-eas-project-id
EXPO_SLUG=your-expo-slug
GITHUB_REPOSITORY=your-github-org-or-user/your-repo

GOOGLE_WEB_CLIENT_ID=your-google-web-oauth-client-id
GOOGLE_ANDROID_CLIENT_ID=your-google-android-oauth-client-id
GOOGLE_IOS_CLIENT_ID=your-google-ios-oauth-client-id

ANDROID_SHA1=your-android-sha1-fingerprint
ANDROID_SHA256=your-android-sha256-fingerprint

APPLE_TEAM_ID=your-apple-team-id
APP_STORE_CONNECT_TEAM_ID=your-app-store-connect-team-id

PRIVACY_POLICY_URL=https://example.com/privacy
SUPPORT_URL=https://example.com/support
