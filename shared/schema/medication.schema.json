{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://med-organizer.local/schema/medication.schema.json",
  "title": "Medication",
  "type": "object",
  "required": ["schemaVersion", "ownerId", "name", "category", "purpose", "dosage", "timesPerDay", "schedule", "intake"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "ownerId": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "genericName": { "type": ["string", "null"] },
    "category": {
      "type": "string",
      "enum": ["prescription", "over-the-counter", "vitamin", "supplement"]
    },
    "purpose": { "type": "string", "minLength": 1 },
    "dosage": { "type": "string", "minLength": 1 },
    "timesPerDay": { "type": "integer", "minimum": 1, "maximum": 12 },
    "schedule": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "time"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "displayTime": { "type": ["string", "null"] },
          "time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }
        },
        "additionalProperties": true
      }
    },
    "intake": { "type": "string", "enum": ["food", "water", "empty"] },
    "foodInstructions": { "type": ["string", "null"] },
    "notes": { "type": ["string", "null"] },
    "quantityRemaining": { "type": ["number", "null"], "minimum": 0 },
    "quantityPerDose": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "refillThreshold": { "type": ["number", "null"], "minimum": 0 },
    "refillReminderEnabled": { "type": ["boolean", "null"] },
    "lastRefillDate": { "type": ["string", "null"] },
    "reminder": {
      "type": "object",
      "required": ["enabled", "leadMinutes"],
      "properties": {
        "enabled": { "type": "boolean" },
        "leadMinutes": { "type": "integer", "minimum": 0, "maximum": 240 }
      },
      "additionalProperties": true
    },
    "attachment": {
      "type": ["object", "null"],
      "properties": {
        "name": { "type": "string" },
        "path": { "type": "string" },
        "url": { "type": "string" },
        "contentType": { "type": "string" },
        "uploadedAt": { "type": "string" }
      },
      "additionalProperties": true
    },
    "createdAt": {},
    "updatedAt": {},
    "updatedBy": { "type": ["string", "null"] },
    "updatedFrom": { "type": ["string", "null"], "enum": ["web", "desktop", "ios", null] }
  },
  "additionalProperties": true
}
