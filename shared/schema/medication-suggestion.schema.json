{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://med-organizer.local/schema/medication-suggestion.schema.json",
  "title": "Medication Suggestion",
  "type": "object",
  "required": ["name", "category", "strengthsAndForms", "commonUses", "source"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "genericName": { "type": ["string", "null"] },
    "brandNames": {
      "type": "array",
      "items": { "type": "string" }
    },
    "category": { "type": "string" },
    "rxTermsName": { "type": ["string", "null"] },
    "strengthsAndForms": {
      "type": "array",
      "items": { "type": "string" }
    },
    "commonUses": {
      "type": "array",
      "items": { "type": "string" }
    },
    "foodInstructions": { "type": "string" },
    "source": { "type": "string" },
    "lastUpdated": { "type": "string" }
  },
  "additionalProperties": true
}
