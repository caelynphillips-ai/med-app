{
  "expo": {
    "name": "Azur Well",
    "slug": "med-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "medorganizer",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.caelynphillips.medorganizer",
      "infoPlist": {
        "NSCameraUsageDescription": "Azur Well can use the camera if your team adds medication label capture later.",
        "NSPhotoLibraryUsageDescription": "Azur Well can use photos if your team adds medication label uploads later."
      }
    },
    "android": {
      "package": "com.caelynphillips.medorganizer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EAF4FF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "firebaseProjectId": "azur-well",
      "githubRepository": "caelynphillips-ai/med-app",
      "eas": {
        "projectId": "28848b7c-4d4f-4eea-a887-0ebc4b760bbc"
      }
    },
    "owner": "blackicebell",
    "plugins": [
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#0080FF",
          "defaultChannel": "medication-reminders"
        }
      ]
    ]
  }
}
