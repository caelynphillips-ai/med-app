rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validAttachment() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches("image/.*|application/pdf|application/octet-stream");
    }

    match /users/{userId}/medications/{medicationId}/{fileName} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && validAttachment();
    }

    match /users/{userId}/{allPaths=**} {
      allow read, write: if false;
    }
  }
}
